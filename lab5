    "def close_pairs(gdf, limit_m=60):\n",
    "    p = gdf.to_crs(32635).geometry.representative_point()\n",
    "    XY = np.c_[p.x.values, p.y.values]\n",
    "    D = np.sqrt(((XY[:, None, :] - XY[None, :, :]) ** 2).sum(-1))\n",
    "    np.fill_diagonal(D, np.inf)\n",
    "    out = [(i, j, D[i, j]) for i in range(len(XY)) for j in range(i + 1, len(XY))\n",
    "           if D[i, j] < limit_m]\n",
    "    return sorted(out, key=lambda t: t[2])\n",
    "\n",
    "\n",
    "def what(row):\n",
    "    \"\"\"Короткий опис об'єкта: теги і тип геометрії.\"\"\"\n",
    "    t = ['%s=%s' % (k, row[k]) for k in ('historic', 'tourism') if k in row and pd.notna(row[k])]\n",
    "    return ', '.join(t + [row.geometry.geom_type])\n",
    "\n",
    "\n",
    "pairs = close_pairs(top_score, 60)\n",
    "print('пар ближче 60 м серед %d найкращих: %d' % (len(top_score), len(pairs)))\n",
    "for i, j, d in pairs:\n",
    "    a, b = top_score.iloc[i], top_score.iloc[j]\n",
    "    print('  %3.0f м | #%d %s [%s]  <->  #%d %s [%s]'\n",
    "          % (d, i + 1, a['name'], what(a), j + 1, b['name'], what(b)))\n",
    "DUP_PAIRS = [(top_score.at[i, 'name'], top_score.at[j, 'name'], float(d)) for i, j, d in pairs]\n",
    "\n",
    "# Ще одна ознака дублікатів: однакові назви серед УСІХ кандидатів.\n",
    "# Якщо об'єкти з однією назвою стоять далеко — це різні об'єкти (напр. кілька братських могил).\n",
    "P = cand.to_crs(32635).geometry.representative_point()\n",
    "XY = dict(zip(cand.index, zip(P.x.values, P.y.values)))\n",
    "NAME_GROUPS = []\n",
    "for nm_, idxs in cand.groupby('name').groups.items():\n",
    "    if len(idxs) < 2:\n",
    "        continue\n",
    "    q = np.array([XY[i] for i in idxs])\n",
    "    dd = np.sqrt(((q[:, None, :] - q[None, :, :]) ** 2).sum(-1))\n",
    "    np.fill_diagonal(dd, np.inf)\n",
    "    NAME_GROUPS.append((nm_, len(idxs), float(dd.min())))\n",
    "NAME_GROUPS.sort(key=lambda t: (-t[1], t[0]))\n",
    "print()\n",
    "print('назв, що трапляються кілька разів: %d' % len(NAME_GROUPS))\n",
    "for nm_, n_, dmin in NAME_GROUPS[:8]:\n",
    "    print('  %-45s %d шт., найближчі одна до одної за %.0f м' % (nm_, n_, dmin))\n",
    "\n",
    "\n",
