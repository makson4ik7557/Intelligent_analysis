    "def tour_length(D, tour):\n",
    "    return float(sum(D[tour[i], tour[i + 1]] for i in range(len(tour) - 1)))\n",
    "\n",
    "def nearest_neighbour(D):\n",
    "    \"\"\"Маршрут 0 -> ... -> 0. Щоразу йдемо в найближчу невідвідану точку.\"\"\"\n",
    "    left = list(range(1, len(D)))          # ще не відвідані (0 — вокзал, з нього стартуємо)\n",
    "    tour = [0]\n",
    "    while left:\n",
    "        nxt = min(left, key=lambda j: D[tour[-1], j])   # найближча до поточної\n",
    "        tour.append(nxt)\n",
    "        left.remove(nxt)\n",
    "    return tour + [0]                      # повертаємось на вокзал\n",
    "\n",
    "def two_opt(D, tour):\n",
    "    \"\"\"Беремо маршрут і розвертаємо ділянки, поки довжина зменшується.\"\"\"\n",
    "    best, best_len = list(tour), tour_length(D, tour)\n",
    "    improved = True\n",
    "    while improved:                        # повторюємо, поки хоч одне розвертання допомогло\n",
    "        improved = False\n",
    "        for i in range(1, len(best) - 2):          # вокзал на початку і в кінці не чіпаємо\n",
    "            for j in range(i + 1, len(best) - 1):\n",
    "                new = best[:i] + best[i:j + 1][::-1] + best[j + 1:]   # A-B..C-D -> A-C..B-D\n",
    "                L = tour_length(D, new)            # рахуємо повністю: так правильно навіть\n",
    "                if L < best_len - 1e-9:            # для несиметричної матриці\n",
    "                    best, best_len, improved = new, L, True\n",
    "    return best"
