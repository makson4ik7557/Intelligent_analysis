    "    ips = sorted({i[4][0] for i in infos})\n",
    "    good = []\n",
    "    for ip in ips:\n",
    "        s = socket.socket(); s.settimeout(timeout)\n",
    "        try:\n",
    "            s.connect((ip, port)); good.append(ip)\n",
    "        except Exception:\n",
    "            pass\n",
    "        finally:\n",
